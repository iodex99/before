# =============================================================================
# BEFORE -- environment template
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# NONE of these values may be shipped inside the iOS bundle.
# =============================================================================

# ---- Supabase -------------------------------------------------------------
# SUPABASE_URL and SUPABASE_ANON_KEY are the only two values the iOS app is
# allowed to know. Everything below them is server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses Row Level Security. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider ----------------------------------------------------------
# One of: anthropic | openai | gemini
AI_PROVIDER=anthropic
# Model id for the selected provider. Sonnet is the default: the analysis is a
# bounded, well-structured task and this is a high-volume consumer path, so it
# costs roughly 40% of Opus per call. Set claude-opus-5 to trade cost for depth.
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# low | medium | high | xhigh | max
AI_EFFORT=medium
# Server-side refusal fallbacks: retries a policy decline on another model.
AI_REFUSAL_FALLBACKS=true

# Deterministic fixture responses instead of a real provider call.
# MUST be false in production -- the backend refuses to boot if this is true
# while APP_ENV=production.
AI_MOCK_MODE=false
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=45000

# ---- App environment ------------------------------------------------------
# development | staging | production
APP_ENV=development

# ---- Quota / rate limiting ------------------------------------------------
FREE_MONTHLY_ANALYSES=5
# Free wardrobe cap; Plus removes it. Deliberately generous -- the wardrobe is
# what makes a verdict personal, and gating it hard would gate result quality.
FREE_WARDROBE_ITEMS=25
# Fair-use ceiling for Plus. Not a plan limit — a ceiling far above genuine use
# that keeps a single account from costing more than it pays. Break-even on the
# yearly plan is ~130/month (backend/scripts/cost-model.mjs), typical use ~12.
# Disclosed in docs/LIMITS.md, because §52 forbids advertising over a real cap.
PLUS_MONTHLY_ANALYSES=100
# Anti-abuse ceilings. Applied to Plus subscribers too (see docs/LIMITS.md).
RATE_LIMIT_ANALYSES_PER_MINUTE=6
RATE_LIMIT_ANALYSES_PER_DAY=40
RATE_LIMIT_METADATA_PER_MINUTE=20
MAX_UPLOAD_BYTES=6291456
MAX_CONCURRENT_ANALYSES=2

# ---- Apple ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Base64 DER of Apple Root CA G3, used to verify every
# signed transaction and every App Store Server Notification. Without it the
# backend cannot verify anything and refuses to boot.
#
#   curl -sO https://www.apple.com/appleca/AppleRootCA-G3.cer
#   base64 -w0 AppleRootCA-G3.cer        # macOS: base64 -i AppleRootCA-G3.cer
#
APPLE_ROOT_CA_G3_BASE64=

# Must match the app's bundle identifier. A transaction for any other bundle id
# is refused, so this is a real check and not a label.
APPLE_BUNDLE_ID=com.yourcompany.before

# App Store Server API credentials. Optional: without them the backend still
# verifies transaction signatures, but cannot reconcile renewals and refunds.
# Set all three or none.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# PEM contents of the .p8 key, newlines escaped as \n
APPLE_PRIVATE_KEY=

# HMAC secret used to derive a stable, non-reversible appAccountToken per user.
APP_ACCOUNT_TOKEN_SECRET=

# ---- Analytics ------------------------------------------------------------
# Provider-neutral. PostHog is the reference implementation.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ENABLED=false

# ---- Legal / config surfaced in-app --------------------------------------
TERMS_URL=https://example.invalid/terms
PRIVACY_URL=https://example.invalid/privacy
SUPPORT_EMAIL=support@example.invalid
