{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:backend)",
      "Bash(npm run test:backend *)",
      "Bash(npm run check:secrets)",
      "Bash(npm run lint:*)",
      "Bash(node --test *)",
      "Bash(swift test *)",
      "Bash(swift build *)",
      "Bash(xcodegen *)",
      "Bash(xcodebuild -list *)",
      "Bash(xcodebuild test *)",
      "Bash(xcodebuild build *)",
      "Bash(supabase db diff *)",
      "Bash(supabase functions list *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(**/AuthKey_*.p8)",
      "Read(**/*.p12)",
      "Read(secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(supabase db reset *)",
      "Bash(supabase db push --linked *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/pre-commit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": ".claude/hooks/lint-on-save.sh" }
        ]
      }
    ]
  },
  "model": "claude-sonnet-5",
  "autoMemoryEnabled": true
}
